# Build from a checkout of https://github.com/JKc66/CircuitVision
FROM python:3.12-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
      ngspice libngspice0 libngspice0-dev build-essential gcc libgl1 libglib2.0-0 git \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && pip install --no-cache-dir PySpice \
 && LIB=$(find / -name 'libngspice.so*' -not -path '/proc/*' 2>/dev/null | head -1) \
 && ln -sf "$LIB" /usr/lib/libngspice.so
ENV SPICE_LIB=/usr/share/ngspice/scripts \
    NGSPICE_LIBRARY_PATH=/usr/lib/libngspice.so \
    PORT=8501
COPY . .
# download_models.py ships with CircuitVision; ignore failure so the app can fetch at runtime
RUN python download_models.py || true
EXPOSE 8501 7860
CMD streamlit run app.py --server.port=${PORT} --server.address=0.0.0.0 --server.headless=true
